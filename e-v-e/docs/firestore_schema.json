{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "E-V-E Firestore Database Schema",
  "description": "Cấu trúc cơ sở dữ liệu NoSQL Firestore của hệ thống giáo dục game hóa E-V-E",
  "version": "2.0.0",
  "collections": {
    "users": {
      "description": "Tài khoản và hồ sơ người dùng (Học sinh, Giáo viên, Admin)",
      "fields": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "Tên người dùng" },
        "email": { "type": "string", "description": "Địa chỉ Email" },
        "role": { "type": "string", "enum": ["student", "teacher", "admin", "school"] },
        "status": { "type": "string", "enum": ["active", "pending", "banned"] },
        "coins": { "type": "number", "default": 0 },
        "xp": { "type": "number", "default": 0 },
        "twoFactorEnabled": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "courses": {
      "description": "Kho khóa học / bài học đơn lẻ kèm cặp câu hỏi tương tác",
      "fields": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "visibility": { "type": "string", "enum": ["private", "public", "free_to_share", "free_to_use"] },
        "isAccepted": { "type": "boolean", "default": false },
        "contentData": {
          "type": "object",
          "properties": {
            "pairs": {
              "type": "array",
              "items": {
                "id": "string",
                "title": "string",
                "description": "string",
                "explanation": "string",
                "distractions": "array"
              }
            }
          }
        },
        "resources": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "learning_path": {
      "description": "Lộ trình học tập xâu chuỗi nhiều bài học",
      "fields": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "authorId": { "type": "string" },
        "courses": { "type": "array", "items": { "type": "string" } },
        "visibility": { "type": "string", "enum": ["private", "public", "free_to_share", "free_to_use"] },
        "isAccepted": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "student_learning_path": {
      "description": "Tiến độ học tập lộ trình của học sinh",
      "fields": {
        "studentId": { "type": "string" },
        "lpathId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "withdrawn"] },
        "completedCourses": { "type": "array", "items": { "type": "string" } },
        "enrolledAt": { "type": "string", "format": "date-time" }
      }
    },
    "game_info": {
      "description": "Danh mục minigame giáo dục HTML5/JS",
      "fields": {
        "gameId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "authorId": { "type": "string" },
        "visibility": { "type": "string", "enum": ["private", "public", "free_to_share", "free_to_use"] },
        "needExtraData": { "type": "boolean" },
        "coursesAllowed": { "type": ["string", "array"] },
        "gameUrl": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "playsCount": { "type": "number", "default": 0 },
        "isAccepted": { "type": "boolean", "default": false },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "game_results": {
      "description": "Lịch sử chơi game và điểm số học sinh",
      "fields": {
        "uid": { "type": "string" },
        "gid": { "type": "string" },
        "cid": { "type": "string" },
        "score": { "type": "number" },
        "rewardCoins": { "type": "number" },
        "accuracy": { "type": "number" },
        "playedAt": { "type": "string", "format": "date-time" }
      }
    },
    "classes": {
      "description": "Không gian lớp học của giáo viên",
      "fields": {
        "classCode": { "type": "string" },
        "name": { "type": "string" },
        "teacherId": { "type": "string" },
        "pathId": { "type": "string" },
        "membersCount": { "type": "number", "default": 0 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "class_members": {
      "description": "Thành viên học sinh trong từng lớp học",
      "fields": {
        "classId": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
