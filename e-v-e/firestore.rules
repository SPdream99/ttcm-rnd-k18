rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION UTILS
    // =========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    // Admin có toàn quyền với mọi thứ trong hệ thống (duyệt, xem, chỉnh sửa, xóa)
    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' || 
        getUserData().role == 'school'
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        getUserData().role == 'teacher' || 
        getUserData().role == 'admin'
      );
    }

    function isAuthor(docData) {
      return isSignedIn() && (
        request.auth.uid == docData.authorId || 
        request.auth.uid == docData.author_id || 
        request.auth.uid == docData.instructorId || 
        request.auth.uid == docData.instructor_id
      );
    }

    // Kiểm tra quyền truy cập (Access/Visibility Levels):
    // 1. private: Không ai thấy trừ bản thân tác giả và Admin
    // 2. public: Công khai xem và học/chơi
    // 3. free_to_share: Công khai, cho phép lồng ghép vào lộ trình của người khác
    // 4. free_to_use: Công khai, cho phép tải về máy
    function canReadContent(docData) {
      return isAdmin() || 
        isAuthor(docData) || 
        !('visibility' in docData) || 
        docData.visibility == 'public' || 
        docData.visibility == 'free_to_share' || 
        docData.visibility == 'free_to_use';
    }

    // =========================================================================
    // 1. USERS COLLECTION
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() || request.resource.data.email != null;
      allow update: if isOwner(userId) || isAdmin() || isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. COURSES (BÀI HỌC)
    // =========================================================================
    match /courses/{courseId} {
      // Chỉ xem được nếu không phải private (hoặc là tác giả / admin)
      allow read: if canReadContent(resource.data);
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      // Tài liệu thuộc sở hữu của ai thì chỉ có họ có thể chỉnh sửa, xóa (Admin có toàn quyền)
      allow update, delete: if isAdmin() || isAuthor(resource.data);
    }

    // =========================================================================
    // 3. LEARNING PATH (LỘ TRÌNH HỌC)
    // =========================================================================
    match /learning_path/{lpathId} {
      allow read: if canReadContent(resource.data);
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      // Chỉ tác giả sở hữu hoặc Admin được sửa, xóa
      allow update, delete: if isAdmin() || isAuthor(resource.data);
    }

    // Tiến độ học tập cá nhân của học sinh trong từng lộ trình
    match /student_learning_path/{docId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }

    // =========================================================================
    // 4. GAME INFO (MINIGAME GIÁO DỤC)
    // =========================================================================
    match /game_info/{gameId} {
      allow read: if canReadContent(resource.data);
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      // Chỉ tác giả sở hữu hoặc Admin được sửa, xóa
      allow update, delete: if isAdmin() || isAuthor(resource.data);
    }

    match /game_results/{resultId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. CLASSES & CLASS MEMBERS (LỚP HỌC & THÀNH VIÊN)
    // =========================================================================
    match /classes/{classId} {
      allow read: if true;
      allow create, update: if isTeacher() || isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isAuthor(resource.data);
    }

    match /class_members/{memberDocId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }

    // =========================================================================
    // 6. ASSIGNMENTS, SUBMISSIONS & LECTURES (BÀI TẬP, BÀI NỘP, BÀI GIẢNG)
    // =========================================================================
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update: if isTeacher() || isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isAuthor(resource.data);
    }

    match /submissions/{submissionId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /lectures/{lectureId} {
      allow read: if canReadContent(resource.data);
      allow create, update: if isTeacher() || isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isAuthor(resource.data);
    }

    // =========================================================================
    // 7. SHOP ITEMS, ANNOUNCEMENTS & RESOURCES
    // =========================================================================
    match /shop_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /resources/{resourceId} {
      allow read: if canReadContent(resource.data);
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      allow update, delete: if isAdmin() || isAuthor(resource.data);
    }

    // Fallback mặc định
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

  }
}
