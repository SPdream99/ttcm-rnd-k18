rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION UTILS
    // =========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' || 
        getUserData().role == 'school'
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        getUserData().role == 'teacher' || 
        getUserData().role == 'admin'
      );
    }

    function isStudent() {
      return isSignedIn() && (
        getUserData().role == 'student' || 
        !('role' in getUserData())
      );
    }

    // =========================================================================
    // 1. USERS COLLECTION
    // =========================================================================
    match /users/{userId} {
      allow read: if true;
      allow create: if isSignedIn() || request.resource.data.email != null;
      allow update: if isOwner(userId) || isAdmin() || isSignedIn();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. COURSES & LEARNING PATHS (KHÓA HỌC & LỘ TRÌNH)
    // =========================================================================
    match /courses/{courseId} {
      allow read: if true;
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      allow update: if isTeacher() || isAdmin() || isOwner(resource.data.author_id);
      allow delete: if isAdmin() || (isTeacher() && isOwner(resource.data.author_id));
    }

    match /learning_path/{lpathId} {
      allow read: if true;
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      allow update: if isTeacher() || isAdmin() || isOwner(resource.data.author_id);
      allow delete: if isAdmin() || (isTeacher() && isOwner(resource.data.author_id));
    }

    // Tiến độ học tập cá nhân của học sinh trong từng lộ trình
    match /student_learning_path/{docId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }

    // =========================================================================
    // 3. CLASSES & CLASS MEMBERS (LỚP HỌC & THÀNH VIÊN)
    // =========================================================================
    match /classes/{classId} {
      allow read: if true;
      allow create, update: if isTeacher() || isAdmin() || isSignedIn();
      allow delete: if isAdmin() || (isTeacher() && isOwner(resource.data.author_id));
    }

    match /class_members/{memberDocId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }

    // =========================================================================
    // 4. ASSIGNMENTS, SUBMISSIONS & LECTURES (BÀI TẬP, BÀI NỘP, BÀI GIẢNG)
    // =========================================================================
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update: if isTeacher() || isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isTeacher();
    }

    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /lectures/{lectureId} {
      allow read: if true;
      allow create, update: if isTeacher() || isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isTeacher();
    }

    // =========================================================================
    // 5. GAME ENGINE & GAME RESULTS (KHO MINIGAME & LỊCH SỬ CHƠI)
    // =========================================================================
    match /game_info/{gameId} {
      allow read: if true;
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      allow update: if isAdmin() || isTeacher();
      allow delete: if isAdmin() || isTeacher();
    }

    match /game_results/{resultId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 6. SHOP ITEMS, ANNOUNCEMENTS & RESOURCES (CỬA HÀNG, THÔNG BÁO, TÀI NGUYÊN)
    // =========================================================================
    match /shop_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow create, update, delete: if isTeacher() || isAdmin() || isSignedIn();
    }

    // Fallback mặc định cho các collection mở rộng khác
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

  }
}
