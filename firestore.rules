rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS & AUTHENTICATION UTILITIES
    // =========================================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : {};
    }

    // Admin & School có toàn quyền tối cao trên toàn hệ thống (duyệt, xem, sửa, xóa, quản trị)
    function isAdmin() {
      return isSignedIn() && (
        getUserData().role == 'admin' || 
        getUserData().role == 'school'
      );
    }

    function isTeacher() {
      return isSignedIn() && (
        getUserData().role == 'teacher' || 
        getUserData().role == 'admin' ||
        getUserData().role == 'school'
      );
    }

    // Kiểm tra quyền tác giả sở hữu tài liệu (Author Ownership)
    function isAuthor(docData) {
      return isSignedIn() && (
        request.auth.uid == docData.authorId || 
        request.auth.uid == docData.author_id || 
        request.auth.uid == docData.instructorId || 
        request.auth.uid == docData.instructor_id ||
        request.auth.uid == docData.uploaderId ||
        request.auth.uid == docData.uploader_id ||
        request.auth.uid == docData.teacher_id ||
        request.auth.uid == docData.teacherId
      );
    }

    // Kiểm tra quyền đọc tài liệu dựa trên 4 cấp độ cấp phép (4-Tier Licensing):
    // 1. private: Chỉ bản thân tác giả và Admin thấy
    // 2. public: Công khai xem và học/chơi
    // 3. free_to_share: Công khai, được phép lồng ghép vào lộ trình của người khác
    // 4. free_to_use: Công khai, được phép tải về máy
    function canReadContent(docData) {
      return isAdmin() || 
        isAuthor(docData) || 
        !('visibility' in docData) || 
        docData.visibility == 'public' || 
        docData.visibility == 'free_to_share' || 
        docData.visibility == 'free_to_use';
    }

    // =========================================================================
    // 1. USERS COLLECTION (NGƯỜI DÙNG & PHÂN QUYỀN)
    // =========================================================================
    match /users/{userId} {
      // Cho phép đọc thông tin công khai (avatar, name, role, decorations)
      allow read: if true;
      // Đăng ký tài khoản mới
      allow create: if isSignedIn() || request.resource.data.email != null;
      // Người dùng chỉnh sửa profile của mình hoặc Admin quản trị
      allow update: if isOwner(userId) || isAdmin() || isSignedIn();
      // Chỉ Admin được xóa tài khoản
      allow delete: if isAdmin();
    }

    // Thông tin chi tiết chuyên ngành của giảng viên
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, update: if isTeacher() || isOwner(teacherId) || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 2. COURSES (BÀI HỌC & CẶP CÂU HỎI TƯƠNG TÁC)
    // =========================================================================
    match /courses/{courseId} {
      // Chỉ đọc được nếu không phải private (hoặc nếu là tác giả / admin)
      allow read: if canReadContent(resource.data);
      // Giáo viên hoặc Admin được tạo bài học mới
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      // Chỉ tác giả sở hữu hoặc Admin mới có quyền cập nhật, thay đổi visibility hoặc xóa
      allow update, delete: if isAdmin() || isAuthor(resource.data);
    }

    // =========================================================================
    // 3. LEARNING PATHS (LỘ TRÌNH HỌC TẬP PHÂN CHẶNG)
    // =========================================================================
    match /learning_path/{lpathId} {
      allow read: if canReadContent(resource.data);
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      // Chỉ tác giả sở hữu hoặc Admin được sửa, cập nhật lộ trình hoặc xóa
      allow update, delete: if isAdmin() || isAuthor(resource.data);
    }

    // Tiến độ học tập cá nhân của học sinh trong từng lộ trình
    match /student_learning_path/{docId} {
      allow read: if true;
      // Học sinh cập nhật tiến độ học tập và mở khóa chặng bài
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }

    // =========================================================================
    // 4. GAME INFO & RESULTS (GAME SDK ENGINE & KẾT QUẢ ĐUA TOP)
    // =========================================================================
    match /game_info/{gameId} {
      allow read: if canReadContent(resource.data);
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      // Chỉ tác giả upload hoặc Admin mới có quyền chỉnh sửa cấu hình game hoặc xóa
      allow update, delete: if isAdmin() || isAuthor(resource.data);
    }

    // Bảng ghi nhận kết quả chơi game, thưởng Coins và tính điểm Leaderboard
    match /game_results/{resultId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. CLASSES & CLASS MEMBERS (LỚP HỌC & DANH SÁCH THÀNH VIÊN)
    // =========================================================================
    match /classes/{classId} {
      allow read: if true;
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      allow update: if isTeacher() || isAdmin() || isAuthor(resource.data);
      allow delete: if isAdmin() || isAuthor(resource.data);
    }

    match /class_members/{memberDocId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin() || isSignedIn();
    }

    // =========================================================================
    // 6. ASSIGNMENTS, SUBMISSIONS & LECTURES (BÀI TẬP, BÀI NỘP, BÀI GIẢNG)
    // =========================================================================
    match /assignments/{assignmentId} {
      allow read: if true;
      allow create, update: if isTeacher() || isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isAuthor(resource.data);
    }

    match /submissions/{submissionId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /lectures/{lectureId} {
      allow read: if canReadContent(resource.data);
      allow create, update: if isTeacher() || isAdmin() || isSignedIn();
      allow delete: if isAdmin() || isAuthor(resource.data);
    }

    // =========================================================================
    // 7. SHOP ITEMS, ANNOUNCEMENTS & ATTACHED RESOURCES
    // =========================================================================
    match /shop_items/{itemId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /resources/{resourceId} {
      allow read: if canReadContent(resource.data);
      allow create: if isTeacher() || isAdmin() || isSignedIn();
      allow update, delete: if isAdmin() || isAuthor(resource.data);
    }

    // =========================================================================
    // FALLBACK SAFEGUARD
    // =========================================================================
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn() || isAdmin();
    }

  }
}
